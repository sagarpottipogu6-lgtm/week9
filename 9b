import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../state/app_state.dart';

class ContentSelectionScreen extends StatefulWidget {
  const ContentSelectionScreen({super.key});

  @override
  State<ContentSelectionScreen> createState() => _ContentSelectionScreenState();
}

class _ContentSelectionScreenState extends State<ContentSelectionScreen> {
  final List<Map<String, dynamic>> _categories = [
    {
      'name': 'Education',
      'icon': Icons.school,
      'color': Colors.blue,
      'image': 'https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?q=80&w=600&auto=format&fit=crop'
    },
    {
      'name': 'Finance',
      'icon': Icons.account_balance_wallet,
      'color': Colors.green,
      'image': 'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?q=80&w=600&auto=format&fit=crop'
    },
    {
      'name': 'Business',
      'icon': Icons.business_center,
      'color': Colors.orange,
      'image': 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=600&auto=format&fit=crop'
    },
    {
      'name': 'Technology',
      'icon': Icons.computer,
      'color': Colors.indigo,
      'image': 'https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=600&auto=format&fit=crop'
    },
    {'name': 'Coding', 'icon': Icons.code, 'color': Colors.blueGrey},
    {'name': 'Motivation', 'icon': Icons.flash_on, 'color': Colors.amber},
    {'name': 'Comedy', 'icon': Icons.sentiment_very_satisfied, 'color': Colors.pink},
    {'name': 'Love', 'icon': Icons.favorite, 'color': Colors.red},
    {'name': 'Emotional', 'icon': Icons.mood, 'color': Colors.purple},
    {'name': 'Sports', 'icon': Icons.sports_soccer, 'color': Colors.deepOrange},
    {'name': 'News', 'icon': Icons.article, 'color': Colors.teal},
    {'name': 'Lifestyle', 'icon': Icons.accessibility_new, 'color': Colors.cyan},
    {'name': 'Travel', 'icon': Icons.flight, 'color': Colors.blueAccent},
    {'name': 'Music', 'icon': Icons.music_note, 'color': Colors.deepPurpleAccent},
    {'name': 'Movies', 'icon': Icons.movie, 'color': Colors.redAccent},
    {'name': 'Health', 'icon': Icons.health_and_safety, 'color': Colors.greenAccent},
  ];

  final Set<String> _selected = {};

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(24.0),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text(
                'What do you want to watch?',
                style: TextStyle(
                  fontSize: 28,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 8),
              Text(
                'Select your interests and personalize your reels.',
                style: TextStyle(
                  fontSize: 16,
                  color: Colors.grey[600],
                ),
              ),
              const SizedBox(height: 24),
              Expanded(
                child: GridView.builder(
                  gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 2,
                    crossAxisSpacing: 16,
                    mainAxisSpacing: 16,
                    childAspectRatio: 1.2,
                  ),
                  itemCount: _categories.length,
                  itemBuilder: (context, index) {
                    final cat = _categories[index];
                    final isSelected = _selected.contains(cat['name']);
                    return GestureDetector(
                      onTap: () {
                        setState(() {
                          if (isSelected) {
                            _selected.remove(cat['name']);
                          } else {
                            _selected.add(cat['name']);
                          }
                        });
                      },
                      child: AnimatedContainer(
                        duration: const Duration(milliseconds: 200),
                        decoration: BoxDecoration(
                          color: isSelected
                              ? cat['color'].withValues(alpha: 0.1)
                              : Colors.white,
                          borderRadius: BorderRadius.circular(20),
                          image: cat['image'] != null
                              ? DecorationImage(
                                  image: NetworkImage(cat['image']),
                                  fit: BoxFit.cover,
                                  colorFilter: ColorFilter.mode(
                                    Colors.black.withValues(alpha: 0.45),
                                    BlendMode.darken,
                                  ),
                                )
                              : null,
                          border: Border.all(
                            color: isSelected ? cat['color'] : Colors.grey[200]!,
                            width: 2,
                          ),
                          boxShadow: isSelected
                              ? [
                                  BoxShadow(
                                    color: cat['color'].withValues(alpha: 0.3),
                                    blurRadius: 8,
                                    offset: const Offset(0, 4),
                                  )
                                ]
                              : [],
                        ),
                        child: Stack(
                          children: [
                            Center(
                              child: Column(
                                mainAxisAlignment: MainAxisAlignment.center,
                                children: [
                                  Icon(
                                    cat['icon'],
                                    size: 40,
                                    color: cat['image'] != null
                                        ? Colors.white
                                        : (isSelected ? cat['color'] : Colors.grey),
                                  ),
                                  const SizedBox(height: 12),
                                  Text(
                                    cat['name'],
                                    style: TextStyle(
                                      fontWeight: FontWeight.bold,
                                      color: cat['image'] != null
                                          ? Colors.white
                                          : (isSelected ? Colors.black : Colors.grey[700]),
                                    ),
                                  ),
                                ],
                              ),
                            ),
                            if (isSelected)
                              Positioned(
                                top: 10,
                                right: 10,
                                child: CircleAvatar(
                                  radius: 12,
                                  backgroundColor: cat['color'],
                                  child: const Icon(Icons.check, size: 16, color: Colors.white),
                                ),
                              ),
                          ],
                        ),
                      ),
                    );
                  },
                ),
              ),
              const SizedBox(height: 24),
              SizedBox(
                width: double.infinity,
                height: 60,
                child: ElevatedButton(
                  onPressed: _selected.isEmpty
                      ? null
                      : () {
                          Provider.of<AppState>(context, listen: false)
                              .setCategories(_selected.toList());
                          Navigator.pushReplacementNamed(context, '/main');
                        },
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF6A2BE2),
                    foregroundColor: Colors.white,
                    disabledBackgroundColor: Colors.grey[300],
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(16),
                    ),
                  ),
                  child: const Text(
                    'Continue',
                    style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
